https://gunicorn.org/run/
https://gunicorn.org/deploy/
https://gunicorn.org/reference/settings/

[Unit]
Description=Gunicorn service for Django Server Monitoring
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/apps/serverMonitoring/server-monitoring
EnvironmentFile=/home/ubuntu/apps/serverMonitoring/.env
ExecStart=/home/ubuntu/apps/serverMonitoring/.venv/bin/gunicorn \
    --workers 1 \
    --bind 127.0.0.1:8000 \
    monitoring.wsgi:application

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
